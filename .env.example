# Dakar WiFi — modèle de configuration (cahier des charges §20).
#
# Copier en `.env` : `cp .env.example .env`
# Toutes les valeurs ci-dessous sont FICTIVES. Aucun secret réel ne doit être
# committé. Les secrets de staging et production proviennent d'un coffre externe
# et ne sont jamais partagés entre environnements.

ENVIRONMENT=local
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000

DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgresql://dakar:dakar@localhost:5432/dakar_wifi
REDIS_URL=redis://localhost:6379/0
DEFAULT_TIMEZONE=Africa/Dakar
DEFAULT_CURRENCY=XOF
LOG_LEVEL=INFO

# Jetons et hachages (§20 v1.1)
# Minimum 32 octets : HMAC-SHA256 avertit en dessous.
JWT_SIGNING_KEY=change-me-to-a-32-byte-minimum-value
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
OTP_HASH_PEPPER=change-me-to-a-32-byte-minimum-value
VOUCHER_HASH_PEPPER=change-me-to-a-32-byte-minimum-value

# Réseau — `mock` tant que le spike OpenWISP n'a pas validé les hypothèses (ADR-0001)
NETWORK_PROVIDER=mock
OPENWISP_BASE_URL=https://openwisp.example.invalid
OPENWISP_API_TOKEN=change-me
OPENWISP_ORGANIZATION_ID=change-me
OPENWISP_ORGANIZATION_SLUG=ville-de-dakar

# SMS/OTP — `mock` jusqu'à contractualisation d'un fournisseur (§22 question 8)
SMS_PROVIDER=mock
SMS_SENDER_ID=DAKAR-WIFI
SMS_API_KEY=change-me

# Paiement — `mock` jusqu'à la phase 7 (§18). Un préfixe par prestataire.
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=change-me

# Paiement (§8.5). Générer avec : openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=insecure-development-payment-webhook-secret
ORDER_PENDING_TTL_SECONDS=1800
PAYMENT_RECONCILE_AFTER_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_CLAIM_TIMEOUT_SECONDS=300

# Observabilité (facultatif en local)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Front-ends (exposé au navigateur : ne jamais y mettre de secret)
PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Docker Compose local
POSTGRES_USER=dakar
POSTGRES_PASSWORD=dakar
POSTGRES_DB=dakar_wifi
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
