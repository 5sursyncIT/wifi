---
import Base from "../layouts/Base.astro";
---

<Base title="Achat — Dakar WiFi">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col gap-6 px-5 py-8">
    <header class="flex items-center gap-3">
      <div
        class="size-12 shrink-0 rounded-lg bg-[var(--color-brand)]"
        role="img"
        aria-label="Emplacement du logo officiel"
      >
      </div>
      <div>
        <p class="text-xl font-bold">Dakar WiFi</p>
        <p class="text-sm text-[var(--color-muted)]">Paiement de votre forfait</p>
      </div>
    </header>

    <section
      id="attente"
      class="rounded-lg border-2 border-amber-500 bg-amber-50 p-5 text-amber-950"
      hidden
    >
      <h1 class="text-xl font-bold">Validez sur votre téléphone</h1>
      <p id="instructions" class="mt-3"></p>
      <p id="compte-a-rebours" class="mt-4 font-bold" role="timer"></p>
    </section>

    <section
      id="redirection"
      class="rounded-lg border-2 border-amber-500 bg-amber-50 p-5 text-amber-950"
      hidden
    >
      <h1 class="text-xl font-bold">Terminez le paiement</h1>
      <p class="mt-3">
        Ouvrez ce lien dans votre navigateur complet pour terminer le paiement.
      </p>
      <a
        id="lien-paiement"
        class="mt-5 block w-full rounded-lg bg-[var(--color-brand)] px-4 py-3 text-center text-base font-bold text-white"
        href="#"
        rel="noopener"
      >
        Ouvrir la page de paiement
      </a>
    </section>

    <section
      id="succes"
      class="rounded-lg border-2 border-[var(--color-brand)] bg-[color-mix(in_srgb,var(--color-brand)_8%,white)] p-5"
      hidden
    >
      <h1 class="text-xl font-bold">Votre accès est activé</h1>
      <p id="recu" class="mt-3"></p>
      <p id="erreur" class="mt-3 font-medium text-red-700" role="alert" hidden></p>
    </section>

    <section id="echec" class="rounded-lg border-2 border-red-600 bg-red-50 p-5 text-red-900" hidden>
      <h1 class="text-xl font-bold">Le paiement n'a pas abouti</h1>
      <p id="raison-echec" class="mt-3" role="alert"></p>
    </section>

    <footer class="mt-auto text-xs text-[var(--color-muted)]">
      Ville de Dakar — paiement sécurisé
    </footer>
  </main>
</Base>

<script>
  import { createPortalClient } from "../lib/portal";
  import { pollOrder } from "../lib/purchase";

  const client = createPortalClient(
    import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000",
  );
  const params = new URLSearchParams(location.search);
  const nasId = params.get("nas_id") ?? "";
  const planVersionId = params.get("offre") ?? "";

  const show = (id: string) => {
    for (const section of document.querySelectorAll<HTMLElement>("section[id]")) {
      section.hidden = section.id !== id;
    }
  };

  /**
   * Kept for the whole tab: a refresh must not place a second order. The API returns
   * the same order for the same key, so reloading resumes rather than charges again.
   */
  const idempotencyKey = (() => {
    const stored = sessionStorage.getItem(`order-key:${planVersionId}`);
    if (stored) return stored;
    const fresh = crypto.randomUUID();
    sessionStorage.setItem(`order-key:${planVersionId}`, fresh);
    return fresh;
  })();

  let countdown: number | undefined;

  function startCountdown(expiresAt: string) {
    const deadline = new Date(expiresAt).getTime();
    const node = document.getElementById("compte-a-rebours")!;
    const tick = () => {
      const left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
      const minutes = String(Math.floor(left / 60)).padStart(2, "0");
      node.textContent = `Temps restant : ${minutes}:${String(left % 60).padStart(2, "0")}`;
      if (left === 0) window.clearInterval(countdown);
    };
    tick();
    countdown = window.setInterval(tick, 1000);
  }

  function fail(message: string) {
    window.clearInterval(countdown);
    document.getElementById("raison-echec")!.textContent = message;
    show("echec");
  }

  async function succeed(orderId: string) {
    window.clearInterval(countdown);
    const receiptNode = document.getElementById("recu")!;
    const errorNode = document.getElementById("erreur")!;
    receiptNode.textContent = "Paiement confirmé. Votre accès est actif.";
    errorNode.hidden = true;
    show("succes");

    try {
      const receipt = await client.getReceipt(orderId);
      receiptNode.textContent =
        `Commande ${receipt.order_number} — ${receipt.amount_xof} ${receipt.currency}`;
    } catch {
      errorNode.textContent =
        "Le paiement a réussi, mais le reçu n’est pas disponible pour le moment.";
      errorNode.hidden = false;
    }
  }

  async function start() {
    try {
      const order = await client.createOrder(nasId, planVersionId, idempotencyKey);
      const deadline = new Date(order.expires_at).getTime();
      document.getElementById("attente")!.dataset.orderNumber = order.order_number;

      if (order.mode === "redirect") {
        const link = document.getElementById("lien-paiement") as HTMLAnchorElement;
        link.href = order.redirect_url;
        show("redirection");
      } else {
        document.getElementById("instructions")!.textContent = order.instructions;
        show("attente");
        startCountdown(order.expires_at);
      }

      void pollOrder({
        orderId: order.id,
        deadline,
        getOrder: (orderId) => client.getOrder(orderId),
        onActive: () => succeed(order.id),
        onExpired: () => fail("Le délai de paiement est écoulé."),
        onTerminal: () => fail("Le paiement a été refusé ou la commande a expiré."),
      });
    } catch {
      fail("La commande n'a pas pu être créée. Réessayez dans un instant.");
    }
  }

  void start();
</script>
