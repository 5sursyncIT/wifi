---
import Base from "../layouts/Base.astro";
---

<Base title="Dakar WiFi">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col gap-6 px-5 py-8">
    <header class="flex items-center gap-3">
      {/* Neutral placeholder: no logo is invented before the City supplies one (§2.2). */}
      <div
        class="size-12 shrink-0 rounded-lg bg-[var(--color-brand)]"
        role="img"
        aria-label="Emplacement du logo officiel"
      >
      </div>
      <div>
        <h1 class="text-xl font-bold">Dakar WiFi</h1>
        <p class="text-sm text-[var(--color-muted)]">Réseau DAKAR-WIFI</p>
      </div>
    </header>

    <section class="rounded-lg border-2 border-amber-500 bg-amber-50 p-4" aria-labelledby="phase">
      <h2 id="phase" class="font-bold text-amber-900">Squelette — Phase 1</h2>
      <p class="mt-1 text-sm text-amber-900">
        Cet écran valide les fondations techniques. L’inscription par OTP arrive en phase 3, le
        choix d’offre et le paiement en phase 4.
      </p>
    </section>

    <section class="rounded-lg border border-black/10 p-4" aria-labelledby="statut">
      <h2 id="statut" class="mb-3 font-bold">État du service</h2>
      <div id="api-status" role="status" aria-live="polite">
        <p class="text-[var(--color-muted)]">Vérification du service…</p>
      </div>
    </section>

    <footer class="mt-auto text-xs text-[var(--color-muted)]">
      Ville de Dakar — plateforme en cours de développement
    </footer>
  </main>
</Base>

<script>
  import { createApiClient } from "@dakar-wifi/api-client";

  const target = document.getElementById("api-status");

  if (target) {
    const baseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";

    createApiClient({ baseUrl })
      .health()
      .then((health) => {
        const rows: [string, string][] = [
          ["État", health.status],
          ["Environnement", health.environment],
          ["Version", health.version],
          ["Base / cache", `${health.checks.database} / ${health.checks.cache}`],
        ];
        const list = document.createElement("dl");
        list.className = "grid grid-cols-2 gap-x-4 gap-y-2 text-sm";
        for (const [label, value] of rows) {
          const term = document.createElement("dt");
          term.className = "text-[var(--color-muted)]";
          term.textContent = label;
          const detail = document.createElement("dd");
          detail.className = "font-medium";
          detail.textContent = value;
          list.append(term, detail);
        }
        target.replaceChildren(list);
      })
      .catch(() => {
        const message = document.createElement("p");
        message.className = "font-medium text-red-700";
        message.textContent = "Service injoignable. Vérifiez que l’API est démarrée.";
        target.replaceChildren(message);
      });
  }
</script>
