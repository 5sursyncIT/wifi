---
import Base from "../layouts/Base.astro";
---

<Base title="Dakar WiFi">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col gap-6 px-5 py-8">
    <header class="flex items-center gap-3">
      {/* Neutral placeholder: no logo is invented before the City supplies one (§2.2). */}
      <div
        class="size-12 shrink-0 rounded-lg bg-[var(--color-brand)]"
        role="img"
        aria-label="Emplacement du logo officiel"
      >
      </div>
      <div>
        <h1 class="text-xl font-bold">Dakar WiFi</h1>
        <p class="text-sm text-[var(--color-muted)]">Réseau DAKAR-WIFI</p>
      </div>
    </header>

    <div id="portal" aria-live="polite">
      <p class="text-[var(--color-muted)]">Chargement des offres…</p>
    </div>

    <footer class="mt-auto text-xs text-[var(--color-muted)]">
      Ville de Dakar — plateforme en cours de développement
    </footer>
  </main>
</Base>

<script>
  import { mountPortal } from "../lib/portal";

  const target = document.getElementById("portal");
  if (target) {
    void mountPortal(target, import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000");
  }
</script>
