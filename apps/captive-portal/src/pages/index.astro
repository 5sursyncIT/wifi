---
import Base from "../layouts/Base.astro";
---

<Base title="Dakar WiFi">
  <main class="mx-auto flex min-h-[calc(100dvh-4.5rem)] max-w-md flex-col gap-5 px-5 py-6" data-i18n-title="brand">
    <header>
      <h1 class="text-2xl font-bold tracking-tight" data-i18n="brand">Dakar WiFi</h1>
      <p class="mt-0.5 text-sm text-muted" data-i18n="network_name">Réseau DAKAR-WIFI</p>
    </header>

    <div id="portal" aria-live="polite">
      <p class="text-muted" data-i18n="loading_offers">Chargement des offres…</p>
    </div>

    <footer class="mt-auto pb-2 text-xs text-muted" data-i18n="footer_dev">
      Ville de Dakar — plateforme en cours de développement
    </footer>
  </main>
</Base>

<script>
  import { mountPortal } from "../lib/portal";

  const target = document.getElementById("portal");
  if (target) {
    void mountPortal(target, import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000");
  }
</script>
